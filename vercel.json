{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm ci --prefix web",
  "buildCommand": "npm run build --prefix web",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "docs/FINAL_REPORT.md",
      "excludeFiles": "{tests/**,web/**,.skycast_local/**,.github/**,supabase/**,requirements-ml.txt,skycast/ml/**,skycast/agents/**,skycast/data/**,skycast/features/**,skycast/pipelines/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
