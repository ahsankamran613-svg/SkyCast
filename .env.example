# =============================================================================
# SkyCast (AgentWeather) — Environment Configuration
# Copy to .env and fill in your free-tier credentials.
# Leave cloud credentials blank (or set SKYCAST_OFFLINE_MODE=true) for Local/Demo Offline Mode.
# =============================================================================

# --- Runtime & Location ---
SKYCAST_ENV=development
SKYCAST_OFFLINE_MODE=auto
SKYCAST_LOCAL_DATA_DIR=.skycast_local
CITY_NAME=Lahore
LAHORE_LAT=31.5204
LAHORE_LON=74.3587
LAHORE_TIMEZONE=Asia/Karachi

# --- Hopsworks Serverless (Feature Store & Model Registry) ---
HOPSWORKS_API_KEY=
HOPSWORKS_PROJECT_NAME=
HOPSWORKS_HOST=c.app.hopsworks.ai

# --- Supabase (Fast-Serving PostgreSQL Cache) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Agentic LLM Chain (Groq Primary -> Gemini Fallback -> Groq Tertiary) ---
# Both Groq API models (openai/gpt-oss-120b & qwen-3.8-27b) must use low reasoning.
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_TERTIARY_MODEL=qwen-3.8-27b
GROQ_REASONING_EFFORT=low

GEMINI_API_KEY=
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

LLM_TIMEOUT_SECONDS=15

# --- GitHub Actions Drift Retraining Trigger (Optional Locally) ---
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_TRAIN_WORKFLOW=training_pipeline.yml
GITHUB_REF=main

# --- API & Frontend ---
VITE_API_BASE_URL=/api
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
